<Project Sdk="Microsoft.NET.Sdk">
  <!--
    A standalone harness for PlacementMatcher — the one piece of pure logic that decides whether a
    sign spawn is the local player's own fresh placement. Not a Unity project and not part of the
    mod build — `utils/link.sh` symlinks only `unity/SignLabels` into the SDK's Assets/, so nothing
    under `tests/` is ever imported by the Editor or packed into the AssetBundle.

    PlacementMatcher has no Unity or game types at all, so it needs no stub layer to compile here —
    unlike item-checklist's possession-harness, which stubs Debug.LogWarning and Vector2.

    The source is COMPILED IN, not copied — a copy would drift, and a drifting test is worse than
    none.

    Note the repo's .gitignore has `*.csproj` (Unity generates those at the root); this file is
    exempted explicitly via `!tests/**/*.csproj`. If it ever goes missing from a commit again, that
    is why.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>SignLabels.Tests</RootNamespace>
    <AssemblyName>PlacementHarness</AssemblyName>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Harness.cs" />
    <Compile Include="../../unity/SignLabels/PlacementMatcher.cs" />
  </ItemGroup>
</Project>
